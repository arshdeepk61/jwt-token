      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token\", jsonData.accessToken);",
                  "    console.log('✓ Token saved: ' + jsonData.accessToken.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript",
                "id": "4e6a152b-17a1-4edb-9319-ba796e920ba1"
              }
            }
          ],
          "id": "7217e8f2-932b-43a5-9655-42daa8bf6ef9",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8085/api/auth/login",
