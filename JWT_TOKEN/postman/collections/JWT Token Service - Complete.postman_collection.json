                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    pm.environment.set(\"jti\", jsonData.jti);",
                  "    console.log('✓ Access Token: ' + jsonData.accessToken.substring(0, 20) + '...');",
                  "    console.log('✓ Refresh Token: ' + jsonData.refreshToken.substring(0, 20) + '...');",
                  "    console.log('✓ JTI: ' + jsonData.jti);",
                  "}"
